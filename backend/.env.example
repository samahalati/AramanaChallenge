# ---- Core ----------------------------------------------------------------
DEBUG=1
SECRET_KEY=change-me-in-production-long-random-string
ALLOWED_HOSTS=*
# SQLite by default (zero setup). PostgreSQL: postgres://user:pass@host:5432/db 
DATABASE_URL=sqlite:///../data/aramana.sqlite3
ACCESS_TOKEN_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Optional LLM investigation assistant (guardrailed; every provider has a FREE tier / is free) ----
# none = deterministic template, no key, no network (default) | gemini | groq | ollama
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
