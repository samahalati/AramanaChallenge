# ---- Core ----------------------------------------------------------------
DEBUG=1
SECRET_KEY=change-me-in-production-long-random-string
ALLOWED_HOSTS=*
# SQLite by default (zero setup). PostgreSQL: postgres://user:pass@host:5432/db 
DATABASE_URL=sqlite:///../data/aramana.sqlite3
ACCESS_TOKEN_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Optional LLM investigation assistant (guardrailed) -------------------------------------------------
# Without a provider the assistant still works (deterministic, evidence-only text; no key, no network).
# LLM_PROVIDER = none | gemini | groq | ollama | custom
#   gemini  Google AI Studio free key  (https://aistudio.google.com/apikey)   default model: gemini-3.5-flash-lite
#   groq    Groq free key              (https://console.groq.com/keys)        default model: llama-3.3-70b-versatile
#   ollama  runs on your machine, no key (https://ollama.com)                  default model: llama3.2
#   custom  ANY OpenAI-compatible service (OpenAI, OpenRouter, Together, Azure, vLLM, LM Studio …):
#           also set LLM_BASE_URL and LLM_MODEL, e.g.  https://api.openai.com/v1  +  gpt-4o-mini
# LLM_MODEL overrides the default model of any provider. LLM_BASE_URL overrides the endpoint of any provider.
# Restart the backend after changing this file.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
